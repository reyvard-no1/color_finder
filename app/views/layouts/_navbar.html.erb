<nav class="bg-white shadow-md sticky top-0 z-10" data-controller="mobile-nav">
  <div class="max-w-7xl mx-auto px-4 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <%= link_to root_path, class: "font-bold text-xl text-gray-900" do %>
        Color Finder
      <% end %>

      <!-- Liens centre (desktop) -->
      <div class="hidden lg:flex items-center gap-6">
        <% if user_signed_in? %>
          <%= link_to "Collections", collections_path, class: "text-gray-700 hover:text-gray-900 font-normal text-sm" %>
        <% end %>
      </div>

      <!-- Boutons droite (desktop) -->
      <div class="hidden lg:flex items-center gap-2">
        <% if user_signed_in? %>
          <span class="text-sm text-gray-700"><%= current_user.name %></span>
          <%= button_to "Déconnexion", destroy_user_session_path,
              method: :delete,
              class: "text-sm px-4 py-2 rounded text-gray-700 hover:bg-gray-100" %>
        <% else %>
          <%= link_to "Log In", new_user_session_path,
              class: "text-sm px-4 py-2 rounded text-gray-700 hover:bg-gray-100 font-medium" %>
          <%= link_to "Sign In", new_user_registration_path,
              class: "text-sm px-4 py-2 rounded bg-gray-900 text-white hover:bg-gray-700 font-medium" %>
        <% end %>
      </div>

      <!-- Bouton hamburger (mobile) -->
      <button class="lg:hidden"
              data-action="click->mobile-nav#toggle"
              data-mobile-nav-target="button">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Menu mobile -->
  <div class="lg:hidden hidden px-4 pb-4" data-mobile-nav-target="menu">
    <% if user_signed_in? %>
      <%= link_to "Collections", collections_path, class: "block py-2 text-sm text-gray-700" %>
      <span class="block py-2 text-sm text-gray-700"><%= current_user.name %></span>
      <%= button_to "Déconnexion", destroy_user_session_path,
          method: :delete,
          class: "block w-full text-left py-2 text-sm text-gray-700" %>
    <% else %>
      <%= link_to "Log In", new_user_session_path, class: "block py-2 text-sm text-gray-700" %>
      <%= link_to "Sign In", new_user_registration_path, class: "block py-2 text-sm text-gray-700" %>
    <% end %>
  </div>
</nav>
